<?xml version="1.0" encoding="UTF-8"?>
<!--
  Chrome-style layout (x64 / x86 only):

    ProgramFiles\ChewingTextService\chewing_tip.dll      stable stub, the only registered COM server
    ProgramFiles\ChewingTextService\tsfreg.exe, chewing.ico
    ProgramFiles\ChewingTextService\<version>\...        one folder per version (dictionaries, tip, host, settings)

  Version folders are Permanent: an upgrade never touches the files an already running program has
  loaded, so no restart is needed. After each install tsfreg keeps only the newest two folders, and an
  uninstall removes them all.
-->
<?include version.wxi?>

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
    <Package Name="新酷音輸入法 (TSF)" Codepage="65001" Language="1028" Manufacturer="新酷音輸入法開發團隊" Version="$(var.Version)" UpgradeCode="8085e4ce-205d-4c44-9450-59ba34163b2a">
        <MajorUpgrade AllowDowngrades="yes" Schedule="afterInstallValidate" />
        <Property Id="REBOOT" Value="ReallySuppress" />
        <!-- never let Windows close other programs on its own: applies to every session, including the removal of the old product during an upgrade -->
        <Property Id="MSIRESTARTMANAGERCONTROL" Value="Disable" />
        <Property Id="MSIDISABLERMRESTART" Value="1" />
        <MediaTemplate CompressionLevel="mszip" EmbedCab="yes" />
        <StandardDirectory Id="ProgramMenuFolder">
            <Directory Id="ApplicationProgramsFolder" Name="新酷音輸入法 (TSF)" />
        </StandardDirectory>

        <StandardDirectory Id="ProgramFiles64Folder">
            <Directory Id="INSTALLFOLDER64" Name="ChewingTextService">
                <Component Id="StubX64" Guid="6c0b2f4e-5b61-4a53-9a43-0c5d1b0f7a11" Bitness="always64" Permanent="yes">
                    <File Id="x64.stub" Source="x64\chewing_tip_stub.dll" Name="chewing_tip.dll" KeyPath="yes" />
                    <Class Advertise="no" Context="InprocServer32" Description="新酷音輸入法 (TSF)" Id="13F2EF08-575C-4D8C-88E0-F67BB8052B84" ThreadingModel="apartment" Server="x64.stub" />
                </Component>
                <Component Id="RootTools" Guid="a7d1c9b2-3e44-4f6a-8c21-5b9e7d0a2c33" Bitness="always64">
                    <File Id="tsfreg.exe" Source="tsfreg.exe" KeyPath="yes" />
                    <File Id="chewing.ico" Source="chewing.ico" />
                </Component>

                <Directory Id="VERDIR64" Name="$(var.Version)">
                    <Component Id="VerFiles64" Guid="@VerFiles64@" Bitness="always64" Permanent="yes">
                        <File Id="x64.impl" Source="x64\chewing_tip_x64.dll" Name="chewing_tip_impl.dll" KeyPath="yes" />
                        <File Id="ChewingPreferences.exe" Source="ChewingPreferences.exe" />
                        <File Id="ChewingEditor.exe" Source="chewing-editor.exe" />
                        <File Id="chewing_tip_host.exe" Source="chewing_tip_host.exe" />
                        <File Id="chewing_cli.exe" Source="chewing-cli.exe" />
                        <File Id="WebView2Loader.dll" Source="WebView2Loader.dll" />
                        <File Id="version.json" Source="version.json" />
                    </Component>
                    <Directory Id="Dictionary" Name="Dictionary">
                        <Component Id="Dict64" Guid="@Dict64@" Bitness="always64" Permanent="yes">
                            <File Id="dict.static_dict.bin" Source="Dictionary\static_dict.bin" KeyPath="yes" />
                            <File Id="dict.swkb.dat" Source="Dictionary\swkb.dat" />
                            <File Id="dict.symbols.dat" Source="Dictionary\symbols.dat" />
                            <File Id="dict.rare_dict.bin" Source="Dictionary\rare_dict.bin" />
                            <File Id="dict.static_words.bin" Source="Dictionary\static_words.bin" />
                            <File Id="dict.static_lm.bin" Source="Dictionary\static_lm.bin" />
                        </Component>
                    </Directory>
                </Directory>

                <!-- Start menu shortcuts and URL protocols always point at the version being installed -->
                <Component Id="Shortcuts" Guid="2f5e8a60-91c7-4d0b-b6a4-7e3c1d9f8b55" Bitness="always64">
                    <Shortcut Id="ShortcutPrefs" Name="設定新酷音輸入法" Directory="ApplicationProgramsFolder" Target="[VERDIR64]ChewingPreferences.exe" Icon="icon.exe" />
                    <Shortcut Id="ShortcutEditor" Name="編輯使用者詞庫" Directory="ApplicationProgramsFolder" Target="[VERDIR64]chewing-editor.exe" Icon="icon.exe" />
                    <RemoveFolder Id="RemoveProgramsFolder" Directory="ApplicationProgramsFolder" On="uninstall" />
                    <RegistryValue Root="HKCU" Key="Software\ChewingTextService\Install" Name="Shortcuts" Type="integer" Value="1" KeyPath="yes" />
                </Component>
                <Component Id="Protocols" Guid="c41b7d92-6a08-4e35-9f1d-2b8a5c6e7f66" Bitness="always64">
                    <RegistryKey Root="HKCR" Key="chewing-preferences">
                        <RegistryValue Type="string" Value="URL:Chewing Preferences" />
                        <RegistryValue Name="URL Protocol" Type="string" Value="" />
                    </RegistryKey>
                    <RegistryKey Root="HKCR" Key="chewing-preferences\DefaultIcon"><RegistryValue Type="string" Value="[VERDIR64]ChewingPreferences.exe,0" /></RegistryKey>
                    <RegistryKey Root="HKCR" Key="chewing-preferences\shell\open\command"><RegistryValue Type="string" Value="&quot;[VERDIR64]ChewingPreferences.exe&quot; &quot;%1&quot;" /></RegistryKey>
                    <RegistryKey Root="HKCR" Key="chewing-editor">
                        <RegistryValue Type="string" Value="URL:Chewing Editor" />
                        <RegistryValue Name="URL Protocol" Type="string" Value="" />
                    </RegistryKey>
                    <RegistryKey Root="HKCR" Key="chewing-editor\DefaultIcon"><RegistryValue Type="string" Value="[VERDIR64]chewing-editor.exe,0" /></RegistryKey>
                    <RegistryKey Root="HKCR" Key="chewing-editor\shell\open\command"><RegistryValue Type="string" Value="&quot;[VERDIR64]chewing-editor.exe&quot; &quot;%1&quot;" /></RegistryKey>
                    <RegistryKey Root="HKCR" Key="chewing-update-svc">
                        <RegistryValue Type="string" Value="URL:Chewing Update Service" />
                        <RegistryValue Name="URL Protocol" Type="string" Value="" />
                    </RegistryKey>
                    <RegistryKey Root="HKCR" Key="chewing-update-svc\DefaultIcon"><RegistryValue Type="string" Value="[VERDIR64]chewing_tip_host.exe,0" /></RegistryKey>
                    <RegistryKey Root="HKCR" Key="chewing-update-svc\shell\open\command"><RegistryValue Type="string" Value="&quot;[VERDIR64]chewing_tip_host.exe&quot; &quot;%1&quot;" /></RegistryKey>
                    <RegistryKey Root="HKCR" Key="chewing-tip-host">
                        <RegistryValue Type="string" Value="URL:Chewing TIP Host" />
                        <RegistryValue Name="URL Protocol" Type="string" Value="" />
                    </RegistryKey>
                    <RegistryKey Root="HKCR" Key="chewing-tip-host\DefaultIcon"><RegistryValue Type="string" Value="[VERDIR64]chewing_tip_host.exe,0" /></RegistryKey>
                    <RegistryKey Root="HKCR" Key="chewing-tip-host\shell\open\command"><RegistryValue Type="string" Value="&quot;[VERDIR64]chewing_tip_host.exe&quot; &quot;%1&quot;" /></RegistryKey>
                </Component>
            </Directory>
        </StandardDirectory>

        <StandardDirectory Id="ProgramFilesFolder">
            <Directory Id="INSTALLFOLDER32" Name="ChewingTextService">
                <Component Id="StubX86" Guid="e93a4c17-0d52-4b8e-a1f6-8c7b2d5e9a77" Bitness="always32" Permanent="yes">
                    <File Id="x86.stub" Source="x86\chewing_tip_stub.dll" Name="chewing_tip.dll" KeyPath="yes" />
                    <Class Advertise="no" Context="InprocServer32" Description="新酷音輸入法 (TSF)" Id="13F2EF08-575C-4D8C-88E0-F67BB8052B84" ThreadingModel="apartment" Server="x86.stub" />
                </Component>
                <Directory Id="VERDIR32" Name="$(var.Version)">
                    <Component Id="VerFiles32" Guid="@VerFiles32@" Bitness="always32" Permanent="yes">
                        <File Id="x86.impl" Source="x86\chewing_tip.dll" Name="chewing_tip_impl.dll" KeyPath="yes" />
                    </Component>
                </Directory>
            </Directory>
        </StandardDirectory>

        <Icon Id="icon.exe" SourceFile="chewing.ico" />

        <CustomAction Id="RegisterTSF" FileRef="tsfreg.exe" ExeCommand="-r &quot;[INSTALLFOLDER64]chewing.ico&quot;" Impersonate="no" Execute="deferred" Return="ignore" />
        <CustomAction Id="UnregisterTSF" FileRef="tsfreg.exe" ExeCommand="-u" Impersonate="no" Execute="deferred" Return="ignore" />
        <CustomAction Id="EnableTIP" FileRef="tsfreg.exe" ExeCommand="-i" Impersonate="yes" Execute="deferred" Return="ignore" />
        <CustomAction Id="DisableTIP" FileRef="tsfreg.exe" ExeCommand="-d" Impersonate="yes" Execute="deferred" Return="ignore" />
        <CustomAction Id="PruneVersions64" FileRef="tsfreg.exe" ExeCommand="-p &quot;[INSTALLFOLDER64].&quot;" Impersonate="no" Execute="deferred" Return="ignore" />
        <CustomAction Id="PruneVersions32" FileRef="tsfreg.exe" ExeCommand="-p &quot;[INSTALLFOLDER32].&quot;" Impersonate="no" Execute="deferred" Return="ignore" />
        <CustomAction Id="PurgeVersions64" FileRef="tsfreg.exe" ExeCommand="-P &quot;[INSTALLFOLDER64].&quot;" Impersonate="no" Execute="deferred" Return="ignore" />
        <CustomAction Id="PurgeVersions32" FileRef="tsfreg.exe" ExeCommand="-P &quot;[INSTALLFOLDER32].&quot;" Impersonate="no" Execute="deferred" Return="ignore" />

        <InstallExecuteSequence>
            <Custom Action="RegisterTSF" After="WriteRegistryValues" Condition="Installed=&quot;&quot; AND PREVIOUSVERSIONSINSTALLED=&quot;&quot;" />
            <Custom Action="EnableTIP" After="RegisterTSF" Condition="Installed=&quot;&quot; AND PREVIOUSVERSIONSINSTALLED=&quot;&quot;" />
            <Custom Action="UnregisterTSF" Before="RemoveRegistryValues" Condition="PREVIOUSVERSIONSINSTALLED=&quot;&quot; AND REMOVE=&quot;ALL&quot;" />
            <Custom Action="DisableTIP" Before="UnregisterTSF" Condition="PREVIOUSVERSIONSINSTALLED=&quot;&quot; AND REMOVE=&quot;ALL&quot;" />
            <!-- keep the newest two version folders after an install / upgrade -->
            <Custom Action="PruneVersions64" After="InstallFiles" Condition="NOT REMOVE" />
            <Custom Action="PruneVersions32" After="PruneVersions64" Condition="NOT REMOVE" />
            <!-- uninstall (but not the removal done by an upgrade): delete every version folder -->
            <Custom Action="PurgeVersions64" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
            <Custom Action="PurgeVersions32" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
        </InstallExecuteSequence>
    </Package>
</Wix>
